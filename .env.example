# From @BotFather. Keep it on this Mac only; never commit it.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs. Empty = refuse every Telegram user except the admin.
TELEGRAM_ALLOWED_USER_IDS=
# Your numeric user ID. The admin can /allow and /deny friends.
TELEGRAM_ADMIN_USER_ID=
# Optional HTTP/SOCKS proxy used to reach Telegram, e.g. socks5://127.0.0.1:7890
TELEGRAM_PROXY=
# Voice for spoken replies: Serena (soft female), Vivian (bright female), Uncle_Fu (calm male).
TTS_SPEAKER=Serena

# The phone API runs in the same process as Telegram and listens on 127.0.0.1 only.
MOBILE_ENABLED=0
MOBILE_PORT=8765
MOBILE_PUBLIC_URL=https://assistant.example.com
# Private PWA: a fixed HTTPS origin for passkeys; never inferred from request headers.
PWA_ENABLED=1
# Skills library (seeded by scripts/install_skills.py). Edit SKILL.md files here; new tasks read them.
FRIDAY_SKILLS_DIR=~/.friday/skills
# By default only passkey browser sessions are accepted. Enable these only for the native app.
MOBILE_NATIVE_ENABLED=0
MOBILE_NATIVE_PAIRING=0

# Google Web OAuth. Refresh tokens are stored in the macOS Keychain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://assistant.example.com/v1/oauth/google/callback
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# Apple Push Notifications. Keep the .p8 key file on this Mac, outside the repository.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_KEY_FILE=

# 1 = in-process agent (memory, history search, scheduled tasks, short-drama tools); 0 or empty = Pi Agent.
AGENT_V2=0
